#
# Sets Prezto options.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

# Set case-sensitivity for completion, history lookup, etc.
# zstyle ':prezto:*:*' case-sensitive 'yes'

# Color output (auto set to 'no' on dumb terminals).
zstyle ':prezto:*:*' color 'yes'

# Set the Prezto modules to load (browse modules).
# The order matters.
zstyle ':prezto:load' pmodule \
  'environment' \
  'terminal' \
  'editor' \
  'history' \
  'directory' \
  'spectrum' \
  'utility' \
  'completion' \
  'history-substring-search' \
  'prompt'

# Set the key mapping style to 'emacs' or 'vi'.
zstyle ':prezto:module:editor' key-bindings 'vi'

#
# Prompt
#

# Set the prompt theme to load.
# Setting it to 'random' loads a random theme.
# Auto set to 'off' on dumb terminals.
zstyle ':prezto:module:prompt' theme 'pure'

# Aliases
alias c="cd .."
alias www="cd /var/www"
alias ll="ls -la"

# "Using sudo with user dotfiles and aliases"
# https://medium.com/@alexcg1/using-sudo-with-user-dotfiles-and-aliases-db76813007e
alias nocorrectsudo='nocorrect sudo -E '

# Libs and utilities
alias pn="pnpm"
alias zj="zellij"
alias nv="nvim"

# AdonisJS command line framework
alias nace="node ace"

# Commands to find current Node processes
alias findnodeports="lsof -nP -iTCP -sTCP:LISTEN | grep node"


# Set the history timestamp format.
HISTTIMEFORMAT="%F %T "


# --------------------------------------------
# Git aliases
alias gitshowmestupid="echo 'git clean -fd'"
alias gitfake="git add . && git commit -m 'fake'"
alias gitresetlast="git reset HEAD~1"
alias gitstashpull="git stash -u && git pull && git stash pop"
alias gst="git status"
alias gitrestorecheckoutclean="git restore --staged . && git checkout . && git clean -fd"

# TO CHECK
alias history="history"
export HISTSIZE=2000
SAVEHIST=$HISTSIZE

# ------------------------------------------------------------
# Ansible
export PATH="/Users/arthur/Library/Python/3.9/bin:$PATH"
# export ANSIBLE_CONFIG=~/.ansible/ansible.cfg
export DEFAULT_HOST_LIST=~/.ansible/hosts
# Ansible
alias ansibleplaybook='ansible-playbook -i ~/.ansible/hosts.yml -e "@~/.ansible/secrets.yml" --vault-password-file ~/.ansible/vault_pass_file'

# zellij path
export PATH="$HOME/zellij-bin/bin:$PATH"

# custom functions
function mkcd() {
  mkdir "${1}" && cd "${1}"
}

function sitespeed() {
  docker run --rm -v "$(pwd):/sitespeed.io" sitespeedio/sitespeed.io:33.5.0 "${1}"
}

# Cursor as blinking bar
# export TERM=xterm

_fix_cursor() {
  echo -ne '\e[5 q'
}

precmd_functions+=(_fix_cursor)

# --------------------------------------------
# https://stackoverflow.com/a/30029855
# List all listening ports, optionally filtering by a pattern
listening() {
   if [ $# -eq 0 ]; then
        sudo lsof -iTCP -sTCP:LISTEN -n -P
    elif [ $# -eq 1 ]; then
        sudo lsof -iTCP -sTCP:LISTEN -n -P | grep -i --color $1
    else
        echo "Usage: listening [pattern]"
    fi
}

function worktree() {
  current_dir=$(pwd)
  wt_path="${1}"

  (
    cd "${current_dir}" &&
    git worktree add "${wt_path}/${2}" "${2}" &&
    cp .env "${wt_path}/${2}" &&
    cd "${wt_path}/${2}" &&
    # yarn &&
    # yarn schema
  )
}


# GPG
export GPG_TTY=$(tty)

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion

# --------------------------------------------
# Set additional custom rules if needed
# source .zpreztorc.local only if it exists
#
if [ -f ~/.zpreztorc.local ]; then
  source ~/.zpreztorc.local
fi

